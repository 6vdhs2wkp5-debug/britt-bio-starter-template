---
import { SITE_TITLE } from '../consts';
import { PROFILE, BOOK_CALL } from '../resume';
const today = new Date();
---

<footer>
	<div class="inner">
		<p class="made">Based in San Francisco, California</p>
		<p class="links">
			<a href={BOOK_CALL.href} target={BOOK_CALL.external ? '_blank' : undefined} rel={BOOK_CALL.external ? 'noopener' : undefined}>Book a call</a>
			<a href={`mailto:${PROFILE.email}`}>Email</a>
			<a href={PROFILE.linkedin} target="_blank" rel="noopener">LinkedIn</a>
			<a href={PROFILE.resume} target="_blank" rel="noopener">Resume</a>
		</p>
		<p class="copy">&copy; {today.getFullYear()} {SITE_TITLE}</p>
	</div>
</footer>
<style>
	footer {
		margin-top: 4em;
		color: rgba(255, 255, 255, 0.82);
		text-align: center;
	}
	.inner {
		background: var(--ink);
		padding: 2.8em 1em 2.8em;
	}
	.made {
		margin: 0 0 0.25em;
		font-family: var(--serif);
		font-style: italic;
		font-size: 1.2em;
		color: #fff;
	}
	.links {
		display: flex;
		justify-content: center;
		gap: 2em;
		margin: 0.8em 0;
		font-size: var(--caps-size);
		font-weight: 500;
		letter-spacing: var(--caps-track);
		text-transform: uppercase;
	}
	.links a {
		color: #fff;
		text-decoration: none;
		border-bottom: 1px solid rgba(255, 255, 255, 0.35);
	}
	.links a:hover {
		color: var(--champagne);
	}
	.copy {
		margin: 0;
		font-size: 0.8em;
		letter-spacing: 0.04em;
	}
</style>
