---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
	<div class="inner">
		<p class="copy">&copy; {today.getFullYear()} {SITE_TITLE} &nbsp;·&nbsp; San Francisco</p>
	</div>
</footer>
<style>
	footer {
		margin-top: 3em;
		color: rgba(255, 255, 255, 0.82);
		text-align: center;
	}
	.inner {
		background: rgba(11, 22, 38, 0.82);
		padding: 2em 1em;
	}
	.links {
		display: flex;
		justify-content: center;
		gap: 2em;
		margin: 0.8em 0;
		font-size: var(--caps-size);
		font-weight: 500;
		letter-spacing: var(--caps-track);
		text-transform: uppercase;
	}
	.links a {
		color: #fff;
		text-decoration: none;
		border-bottom: 1px solid rgba(255, 255, 255, 0.35);
	}
	.links a:hover {
		color: var(--champagne);
	}
	.copy {
		margin: 0;
		font-size: 0.8em;
		letter-spacing: 0.04em;
	}
</style>
