---
import { SITE_TITLE } from '../consts';
import { PROFILE, BOOK_CALL } from '../resume';
const today = new Date();
const bookAttrs = BOOK_CALL.external ? { target: '_blank', rel: 'noopener' } : {};
---

<footer>
	<div class="inner">
		<div class="brand">
			<p class="name">{SITE_TITLE}</p>
			<p class="sub">Executive Assistant &amp; Office Manager · San Francisco</p>
		</div>
		<nav class="links" aria-label="Contact">
			<a href={BOOK_CALL.href} {...bookAttrs}>Book a call</a>
			<a href={`mailto:${PROFILE.email}`}>Email</a>
			<a href={PROFILE.linkedin} target="_blank" rel="noopener">LinkedIn</a>
			<a href={PROFILE.resume} target="_blank" rel="noopener">Resume</a>
		</nav>
	</div>
	<p class="copy">&copy; {today.getFullYear()} {SITE_TITLE}</p>
</footer>
<style>
	footer {
		background: var(--ink-dark);
		color: rgba(255, 255, 255, 0.7);
		padding: 3.5rem 0 2rem;
	}
	.inner,
	.copy {
		width: 1120px;
		max-width: calc(100% - 3rem);
		margin: 0 auto;
	}
	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem 3rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.12);
	}
	.name {
		margin: 0;
		font-family: var(--serif);
		font-size: 1.6rem;
		line-height: 1.2;
		color: #fff;
	}
	.sub {
		margin: 0.35rem 0 0;
		font-size: 0.82rem;
		letter-spacing: 0.02em;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2rem;
	}
	.links a {
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: #fff;
		text-decoration: none;
	}
	.links a:hover {
		color: var(--champagne);
	}
	.copy {
		margin-top: 1.5rem;
		margin-bottom: 0;
		font-size: 0.75rem;
		letter-spacing: 0.04em;
	}
	@media (max-width: 640px) {
		.inner,
		.copy {
			max-width: calc(100% - 2.5rem);
		}
	}
</style>
