---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
	<svg class="skyline" viewBox="0 0 1200 60" preserveAspectRatio="none" aria-hidden="true">
		<path
			d="M0 60 V44 Q90 26 180 40 T360 34 L380 34 V20 H392 V34 L470 36 Q560 22 640 38 L660 38 L668 6 L676 38 L720 38 V26 H736 V38 H760 V18 H778 V38 L840 40 Q960 20 1060 36 T1200 32 V60 Z"
		></path>
	</svg>
	<div class="inner">
		<p class="made">Made in San Francisco, usually under a blanket of fog.</p>
		<p class="copy">&copy; {today.getFullYear()} {SITE_TITLE}</p>
	</div>
</footer>
<style>
	footer {
		margin-top: 4em;
		color: rgba(255, 255, 255, 0.82);
		text-align: center;
	}
	.skyline {
		display: block;
		width: 100%;
		height: 48px;
		fill: var(--bay);
	}
	.inner {
		background: var(--bay);
		padding: 1.5em 1em 3em;
	}
	.made {
		margin: 0 0 0.25em;
		font-family: var(--serif);
		font-size: 1.05em;
		color: #fff;
	}
	.copy {
		margin: 0;
		font-size: 0.8em;
		letter-spacing: 0.04em;
	}
</style>
