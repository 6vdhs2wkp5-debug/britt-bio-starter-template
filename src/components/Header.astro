---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
import { PROFILE } from '../resume';
---

<header>
	<nav>
		<a class="brand" href="/">
			<span>{SITE_TITLE}</span>
		</a>
		<div class="internal-links">
			<a class="hide-sm" href="/#expertise">Expertise</a>
			<a class="hide-sm" href="/#experience">Experience</a>
			<a class="hide-sm" href="/#ai">AI workflows</a>
			<HeaderLink href="/about">About</HeaderLink>
			<a class="resume-btn" href={PROFILE.resume} target="_blank" rel="noopener">Resume</a>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		margin: 0;
		padding: 0 1em;
		background: rgba(251, 250, 247, 0.9);
		backdrop-filter: saturate(1.4) blur(10px);
		-webkit-backdrop-filter: saturate(1.4) blur(10px);
		border-bottom: 1px solid var(--rule);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 1120px;
		max-width: calc(100% - 1rem);
		margin: 0 auto;
		min-height: 4.5rem;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.55em;
		padding: 0.6em 0;
		color: rgb(var(--black));
		font-family: var(--serif);
		font-weight: 500;
		font-size: 1.45rem;
		letter-spacing: 0.01em;
		text-decoration: none;
	}
	.brand img {
		border-radius: 7px;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.25em;
	}
	nav .internal-links a.resume-btn {
		margin-left: 1rem;
		padding: 0.85rem 1.4rem;
		font-size: 0.68rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		border: 0;
		border-radius: 2px;
		background: var(--ink);
		color: #fff;
		font-weight: 500;
	}
	nav .internal-links a.resume-btn:hover {
		background: var(--ink-dark);
		color: #fff;
	}
	nav .internal-links a {
		padding: 1.6rem 0.85rem;
		color: rgb(var(--gray-dark));
		border-bottom: 1px solid transparent;
		text-decoration: none;
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}
	nav .internal-links a:hover {
		color: var(--accent);
	}
	nav .internal-links a.active {
		color: rgb(var(--black));
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	@media (max-width: 760px) {
		.hide-sm {
			display: none;
		}
	}
	@media (max-width: 520px) {
		.brand {
			font-size: 1.25rem;
		}
		nav .internal-links a {
			padding: 1.4rem 0.5rem;
		}
	}
</style>
