---
import BaseHead from '../components/BaseHead.astro';
import PhotoCredit from '../components/PhotoCredit.astro';
import { SITE_DESCRIPTION } from '../consts';
import { PHOTOS } from '../photos';
import { PROFILE, BOOK_CALL } from '../resume';

const bg = PHOTOS.night;
const pageTitle = `${PROFILE.name} | Executive Assistant & Office Manager, San Francisco`;
const year = new Date().getFullYear();

const personJsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: PROFILE.name,
	jobTitle: 'Executive Assistant',
	image: new URL(PROFILE.headshot, Astro.site).toString(),
	url: Astro.site?.toString(),
	email: `mailto:${PROFILE.email}`,
	sameAs: [PROFILE.linkedin],
	address: { '@type': 'PostalAddress', addressLocality: 'San Francisco', addressRegion: 'CA' },
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={SITE_DESCRIPTION} image="/og-image.jpg" />
		<script type="application/ld+json" set:html={personJsonLd} />
	</head>
	<body>
		<main class="landing">
			<img
				class="bg"
				src={bg.src}
				srcset={`${bg.srcSmall} 960w, ${bg.src} 1280w`}
				sizes="100vw"
				width={bg.width}
				height={bg.height}
				alt=""
				fetchpriority="high"
			/>
			<div class="shade" aria-hidden="true"></div>

			<section class="card" aria-labelledby="name">
				<img
					class="avatar"
					src={PROFILE.headshotSmall}
					srcset={`${PROFILE.headshotSmall} 320w, ${PROFILE.headshot} 640w`}
					sizes="132px"
					width="132"
					height="132"
					alt={`Portrait of ${PROFILE.name}`}
				/>
				<h1 id="name">{PROFILE.name}</h1>
				<p class="role">{PROFILE.title}</p>
				<p class="line">
					Thoughtful, trusted support for partners and investment leaders in San&nbsp;Francisco.
				</p>
				<span class="bar" aria-hidden="true"></span>

				<div class="actions">
					<a
						class="button primary"
						href={BOOK_CALL.href}
						target={BOOK_CALL.external ? '_blank' : undefined}
						rel={BOOK_CALL.external ? 'noopener' : undefined}>Book a call</a
					>
					<a class="button" href={PROFILE.linkedin} target="_blank" rel="noopener">LinkedIn</a>
					<a class="button" href={`mailto:${PROFILE.email}`}>Email</a>
					<a class="button" href={PROFILE.resume} download>Résumé</a>
				</div>
				<a class="email" href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
			</section>

			<footer class="foot">
				<span>&copy; {year} {PROFILE.name} · San Francisco, California</span>
				<PhotoCredit photo={bg} class="credit" />
			</footer>
		</main>
	</body>
</html>

<style>
	:global(body) {
		background: #0b1424;
	}
	.landing {
		position: relative;
		width: 100%;
		max-width: none;
		min-height: 100vh;
		min-height: 100svh;
		margin: 0;
		padding: 2rem 1rem 4.5rem;
		display: grid;
		place-items: center;
		overflow: hidden;
		box-sizing: border-box;
		color: #fff;
	}
	.bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 65% 50%;
		border-radius: 0;
	}
	.shade {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse at center, rgba(9, 16, 30, 0.55) 0%, rgba(9, 16, 30, 0.85) 75%),
			rgba(9, 16, 30, 0.25);
	}
	.card {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 34rem;
		padding: 2.6rem 2rem 2.2rem;
		text-align: center;
		border-radius: 22px;
		background: rgba(15, 26, 44, 0.55);
		border: 1px solid rgba(255, 255, 255, 0.14);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
		box-sizing: border-box;
	}
	.avatar {
		display: block;
		width: 132px;
		height: 132px;
		margin: 0 auto 1.3rem;
		border-radius: 50%;
		object-fit: cover;
		border: 4px solid #fff;
		box-shadow:
			0 0 0 4px var(--accent),
			0 12px 30px rgba(0, 0, 0, 0.45);
	}
	h1 {
		margin: 0 0 0.25em;
		color: #fff;
		font-size: clamp(2.3rem, 7vw, 3.2rem);
		line-height: 1.05;
	}
	.role {
		margin: 0 0 0.8rem;
		font-size: clamp(1.05rem, 3.2vw, 1.3rem);
		color: var(--champagne);
	}
	.line {
		margin: 0 auto 1.2rem;
		max-width: 26em;
		font-size: 0.95rem;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.85);
	}
	.bar {
		display: block;
		width: 64px;
		height: 4px;
		margin: 0 auto 1.6rem;
		border-radius: 2px;
		background: var(--accent);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.6rem;
	}
	.button {
		display: inline-block;
		padding: 0.62em 1.3em;
		border-radius: 999px;
		font-size: 0.88rem;
		font-weight: 700;
		text-decoration: none;
		color: #fff;
		border: 1px solid rgba(255, 255, 255, 0.5);
		background: rgba(255, 255, 255, 0.08);
		transition:
			background 0.15s ease,
			transform 0.15s ease;
	}
	.button:hover {
		color: #fff;
		background: rgba(255, 255, 255, 0.18);
		transform: translateY(-1px);
	}
	.button.primary {
		background: #fff;
		border-color: #fff;
		color: var(--ink);
	}
	.button.primary:hover {
		background: var(--fog);
		color: var(--ink);
	}
	.email {
		display: inline-block;
		margin-top: 1.3rem;
		font-size: 0.85rem;
		color: rgba(255, 255, 255, 0.75);
		text-decoration: none;
		border-bottom: 1px solid rgba(255, 255, 255, 0.3);
	}
	.email:hover {
		color: #fff;
	}
	.foot {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0.9rem;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.3rem 1rem;
		padding: 0 1rem;
		font-size: 0.72rem;
		color: rgba(255, 255, 255, 0.6);
	}
	.foot :global(.credit) {
		color: rgba(255, 255, 255, 0.55);
	}
	@media (max-width: 520px) {
		.card {
			padding: 2.2rem 1.2rem 1.8rem;
		}
		.foot {
			justify-content: center;
			text-align: center;
		}
	}
</style>
