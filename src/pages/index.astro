---
import BaseHead from '../components/BaseHead.astro';
import PhotoCredit from '../components/PhotoCredit.astro';
import { SITE_DESCRIPTION } from '../consts';
import { PHOTOS } from '../photos';
import { PROFILE, BOOK_CALL } from '../resume';

const bg = PHOTOS.night;
const pageTitle = `${PROFILE.name} | Executive Assistant & Office Manager, San Francisco`;
const year = new Date().getFullYear();

// Three facts a hiring manager can take in at a glance.
const FACTS = [
	{ label: 'Experience', value: '8 years', detail: 'Executive support and office management' },
	{ label: 'Focus', value: 'Private equity', detail: 'Partners, deal teams, portfolio CEOs and LPs' },
	{ label: 'Recent firms', value: 'Centana Growth Partners', detail: 'Previously CVC Advisors' },
];

const personJsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: PROFILE.name,
	jobTitle: 'Executive Assistant',
	image: new URL(PROFILE.headshot, Astro.site).toString(),
	url: Astro.site?.toString(),
	email: `mailto:${PROFILE.email}`,
	sameAs: [PROFILE.linkedin],
	address: { '@type': 'PostalAddress', addressLocality: 'San Francisco', addressRegion: 'CA' },
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={SITE_DESCRIPTION} image="/og-image.jpg" />
		<script type="application/ld+json" set:html={personJsonLd} />
	</head>
	<body>
		<div class="page">
			<!-- Photo panel: right side on desktop, a short band on top for phones -->
			<figure class="visual">
				<img
					src={bg.src}
					srcset={`${bg.srcSmall} 960w, ${bg.src} 1280w`}
					sizes="(max-width: 900px) 100vw, 46vw"
					width={bg.width}
					height={bg.height}
					alt={bg.alt}
					fetchpriority="high"
				/>
				<figcaption><PhotoCredit photo={bg} /></figcaption>
			</figure>

			<main class="content">
				<div class="inner">
					<img
						class="avatar"
						src={PROFILE.headshotSmall}
						srcset={`${PROFILE.headshotSmall} 320w, ${PROFILE.headshot} 640w`}
						sizes="(max-width: 900px) 84px, 104px"
						width="104"
						height="104"
						alt={`Portrait of ${PROFILE.name}`}
					/>

					<p class="eyebrow">{PROFILE.title}</p>
					<h1>{PROFILE.name}</h1>
					<p class="lede">
						A San Francisco executive assistant dedicated to helping partners and investment leaders reach their goals.
					</p>

					<p class="status"><span class="dot" aria-hidden="true"></span>San Francisco · Open to new opportunities</p>

					<dl class="facts">
						{
							FACTS.map((f) => (
								<div class="fact">
									<dt>{f.label}</dt>
									<dd>
										<span class="value">{f.value}</span>
										<span class="detail">{f.detail}</span>
									</dd>
								</div>
							))
						}
					</dl>

					<div class="actions">
						<a
							class="btn primary"
							href={BOOK_CALL.href}
							target={BOOK_CALL.external ? '_blank' : undefined}
							rel={BOOK_CALL.external ? 'noopener' : undefined}>Book a call</a
						>
						<a class="btn" href={PROFILE.resume} download>Download résumé</a>
					</div>

					<p class="links">
						<a href={PROFILE.linkedin} target="_blank" rel="noopener">LinkedIn</a>
						<span aria-hidden="true">·</span>
						<a href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
					</p>
				</div>

				<footer class="foot">&copy; {year} {PROFILE.name} · San Francisco, California</footer>
			</main>
		</div>
	</body>
</html>

<style>
	/* Private-bank palette: ivory, deep navy, muted gold */
	.page {
		--ivory: #f7f4ee;
		--navy: #13233a;
		--navy-soft: #3c4a5e;
		--gold: #a8875a;
		--rule: #e3dccf;
		position: relative;
		display: flex;
		align-items: center;
		min-height: 100vh;
		min-height: 100svh;
		padding: 3rem clamp(1rem, 6vw, 6rem);
		box-sizing: border-box;
		background: #0b1424;
		color: var(--navy);
	}
	:global(body) {
		background: #0b1424;
	}

	/* ---------- Full-background photo ---------- */
	.visual {
		position: fixed;
		inset: 0;
		margin: 0;
		overflow: hidden;
	}
	.visual img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 60% 50%;
		border-radius: 0;
	}
	.visual::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(to right, rgba(11, 20, 36, 0.55), rgba(11, 20, 36, 0.1) 60%);
	}
	.visual figcaption {
		position: absolute;
		right: 0.9rem;
		bottom: 0.7rem;
		z-index: 1;
		color: rgba(255, 255, 255, 0.7);
	}

	/* ---------- Ivory card ---------- */
	.content {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 38.5rem;
		margin: 0;
		padding: 2.2rem clamp(1.5rem, 4vw, 3.2rem) 1.6rem;
		box-sizing: border-box;
		background: rgba(247, 244, 238, 0.97);
		border-top: 3px solid var(--gold);
		border-radius: 2px;
		box-shadow: 0 30px 70px rgba(0, 0, 0, 0.45);
	}
	.inner {
		max-width: 33rem;
	}
	.avatar {
		display: block;
		width: 104px;
		height: 104px;
		margin-bottom: 1.3rem;
		border-radius: 50%;
		object-fit: cover;
		border: 3px solid #fff;
		box-shadow:
			0 0 0 1px var(--gold),
			0 10px 24px rgba(19, 35, 58, 0.18);
	}
	.eyebrow {
		margin: 0 0 0.7rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--gold);
	}
	h1 {
		margin: 0 0 0.9rem;
		font-family: var(--serif);
		font-weight: 400;
		font-size: clamp(2.6rem, 5vw, 3.6rem);
		line-height: 1.02;
		letter-spacing: -0.01em;
		color: var(--navy);
	}
	.lede {
		margin: 0 0 1.4rem;
		font-family: var(--serif);
		font-size: clamp(1.1rem, 1.7vw, 1.22rem);
		line-height: 1.5;
		text-wrap: pretty;
		color: var(--navy-soft);
	}
	.status {
		display: inline-flex;
		align-items: center;
		gap: 0.55em;
		margin: 0 0 1.5rem;
		font-size: 0.8rem;
		color: var(--navy-soft);
	}
	.dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--gold);
		box-shadow: 0 0 0 3px rgba(168, 135, 90, 0.2);
	}

	/* At-a-glance facts with fine rules */
	.facts {
		margin: 0 0 1.7rem;
		border-top: 1px solid var(--rule);
	}
	.fact {
		display: grid;
		grid-template-columns: 8.5rem 1fr;
		gap: 1rem;
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--rule);
	}
	.fact dt {
		padding-top: 0.2rem;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--gold);
	}
	.fact dd {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}
	.value {
		font-family: var(--serif);
		font-size: 1.15rem;
		color: var(--navy);
	}
	.detail {
		font-size: 0.82rem;
		color: var(--navy-soft);
	}

	/* Actions */
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-bottom: 1.3rem;
	}
	.btn {
		display: inline-block;
		padding: 0.85em 1.6em;
		border-radius: 2px;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--navy);
		border: 1px solid var(--navy);
		background: transparent;
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}
	.btn:hover {
		background: var(--navy);
		color: #fff;
	}
	.btn.primary {
		background: var(--navy);
		color: #fff;
	}
	.btn.primary:hover {
		background: #0b1626;
		color: #fff;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 0.6rem;
		margin: 0;
		font-size: 0.85rem;
		color: var(--navy-soft);
	}
	.links a {
		color: var(--navy);
		text-decoration: none;
		border-bottom: 1px solid var(--rule);
	}
	.links a:hover {
		border-bottom-color: var(--gold);
	}
	.foot {
		margin-top: 1.4rem;
		font-size: 0.72rem;
		letter-spacing: 0.04em;
		color: #8a8f99;
	}

	/* ---------- Phones and tablets ---------- */
	@media (max-width: 900px) {
		.page {
			align-items: flex-start;
			padding: 175px 0.9rem 1.2rem;
		}
		.visual img {
			object-position: 72% 50%;
		}
		.visual::after {
			background: linear-gradient(to bottom, rgba(11, 20, 36, 0) 25%, rgba(11, 20, 36, 0.35));
		}
		.visual figcaption {
			top: 0.5rem;
			bottom: auto;
			right: 0.6rem;
			font-size: 0.85em;
		}
		.content {
			margin: 0 auto;
			padding: 0 1.3rem 1.4rem;
		}
		.avatar {
			width: 84px;
			height: 84px;
			margin: -42px 0 1.1rem;
		}
		.eyebrow {
			font-size: 0.64rem;
			letter-spacing: 0.13em;
		}
		.lede {
			margin-bottom: 1rem;
		}
		.status {
			margin-bottom: 1.4rem;
		}
		.fact {
			grid-template-columns: 1fr;
			gap: 0.3rem;
			padding: 0.8rem 0;
		}
		.actions .btn {
			flex: 1 1 auto;
			text-align: center;
		}
		.foot {
			margin-top: 1.6rem;
		}
	}
</style>
