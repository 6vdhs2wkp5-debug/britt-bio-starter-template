---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import { PHOTOS } from '../photos';
import PhotoCredit from '../components/PhotoCredit.astro';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const hero = PHOTOS.aerial;
const pano = PHOTOS.skyline;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<section class="hero" aria-labelledby="hero-title">
			<img
				class="hero-photo"
				src={hero.src}
				srcset={`${hero.srcSmall} 960w, ${hero.src} 1920w`}
				sizes="100vw"
				width={hero.width}
				height={hero.height}
				alt={hero.alt}
				fetchpriority="high"
			/>
			<div class="hero-shade" aria-hidden="true"></div>
			<div class="hero-text">
				<p class="coords">37.7749° N &nbsp;·&nbsp; 122.4194° W</p>
				<h1 id="hero-title">Hi, I'm Brittany.</h1>
				<p class="lede">
					Writing, projects and notes from San Francisco: somewhere between the fog, the hills
					and the bay.
				</p>
				<div class="actions">
					<a class="button primary" href="/blog">Read the blog</a>
					<a class="button ghost" href="/about">About me</a>
				</div>
			</div>
			<PhotoCredit photo={hero} class="hero-credit" />
		</section>

		<main class="home">
			<section class="latest" aria-labelledby="latest-title">
				<div class="section-head">
					<h2 id="latest-title">Latest from the blog</h2>
					<a class="see-all" href="/blog">All posts →</a>
				</div>
				<ul class="cards">
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<img src={post.data.heroImage} alt="" width={720} height={360} loading="lazy" />
									)}
									<div class="card-body">
										<p class="date">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<h3>{post.data.title}</h3>
										<p class="desc">{post.data.description}</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<figure class="pano">
				<img
					src={pano.src}
					srcset={`${pano.srcSmall} 960w, ${pano.src} 1920w`}
					sizes="(max-width: 1080px) 100vw, 1080px"
					width={pano.width}
					height={pano.height}
					alt={pano.alt}
					loading="lazy"
				/>
				<figcaption>
					<span>{pano.caption}</span>
					<PhotoCredit photo={pano} />
				</figcaption>
			</figure>

			<section class="city" aria-label="San Francisco">
				<div class="city-card">
					<span class="tag">Local forecast</span>
					<p>Fog in the morning, sun by the afternoon, layers at all times.</p>
				</div>
				<div class="city-card">
					<span class="tag">Based in</span>
					<p>San Francisco, California: 49 square miles, 40-something hills.</p>
				</div>
				<div class="city-card">
					<span class="tag">Say hello</span>
					<p>Read more <a href="/about">about me</a> or catch up on <a href="/blog">the blog</a>.</p>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	/* ---------- Hero ---------- */
	.hero {
		position: relative;
		display: flex;
		align-items: flex-end;
		min-height: clamp(480px, 78vh, 760px);
		overflow: hidden;
		background: var(--bay);
		color: #fff;
	}
	.hero-photo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 55% 35%;
		border-radius: 0;
		animation: settle 1.6s ease-out both;
	}
	@keyframes settle {
		from {
			transform: scale(1.06);
		}
		to {
			transform: scale(1);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-photo {
			animation: none;
		}
	}
	.hero-shade {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(to top, rgba(15, 26, 44, 0.88) 0%, rgba(15, 26, 44, 0.45) 45%, rgba(15, 26, 44, 0.05) 75%),
			linear-gradient(to right, rgba(15, 26, 44, 0.55), transparent 65%);
	}
	.hero-text {
		position: relative;
		z-index: 1;
		width: 1080px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 0 0 clamp(3em, 9vh, 5.5em);
	}
	.hero :global(.hero-credit) {
		position: absolute;
		right: 1em;
		bottom: 0.6em;
		z-index: 1;
		color: rgba(255, 255, 255, 0.8);
	}
	.coords {
		margin: 0 0 0.75em;
		font-size: 0.75em;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--sunset);
	}
	.hero h1 {
		margin: 0 0 0.3em;
		font-size: clamp(2.6rem, 7vw, 4.8rem);
		line-height: 1.02;
		color: #fff;
		text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
	}
	.lede {
		max-width: 30em;
		margin: 0 0 1.5em;
		font-size: clamp(1.05rem, 2.2vw, 1.3rem);
		color: rgba(255, 255, 255, 0.92);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75em;
	}
	.button {
		display: inline-block;
		padding: 0.6em 1.25em;
		border-radius: 999px;
		font-size: 0.9em;
		font-weight: 700;
		text-decoration: none;
		transition:
			transform 0.15s ease,
			background 0.15s ease;
	}
	.button:hover {
		transform: translateY(-1px);
	}
	.button.primary {
		background: var(--accent);
		color: #fff;
	}
	.button.primary:hover {
		background: var(--accent-dark);
		color: #fff;
	}
	.button.ghost {
		background: rgba(255, 255, 255, 0.12);
		color: #fff;
		border: 1px solid rgba(255, 255, 255, 0.55);
		backdrop-filter: blur(6px);
	}
	.button.ghost:hover {
		background: #fff;
		color: rgb(var(--black));
	}

	/* ---------- Latest posts ---------- */
	main.home {
		width: 1080px;
		padding-top: 3.5em;
	}
	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1em;
		margin-bottom: 1.25em;
	}
	.section-head h2 {
		margin: 0;
		font-size: 1.8em;
	}
	.see-all {
		white-space: nowrap;
		font-size: 0.85em;
		font-weight: 700;
		text-decoration: none;
	}
	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.5em;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.cards a {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		border-radius: 14px;
		background: #fff;
		border: 1px solid rgb(var(--gray-light));
		color: inherit;
		text-decoration: none;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}
	.cards a:hover {
		transform: translateY(-3px);
		box-shadow: var(--box-shadow);
	}
	.cards img {
		display: block;
		width: 100%;
		aspect-ratio: 2 / 1;
		object-fit: cover;
		border-radius: 0;
	}
	.card-body {
		padding: 1em 1.2em 1.3em;
	}
	.card-body .date {
		margin: 0 0 0.3em;
		font-size: 0.75em;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.card-body h3 {
		margin: 0 0 0.35em;
		font-size: 1.25em;
	}
	.card-body .desc {
		margin: 0;
		font-size: 0.85em;
		line-height: 1.55;
		color: rgb(var(--gray));
	}

	/* ---------- Panorama ---------- */
	.pano {
		margin: 3.5em 0 0;
	}
	.pano img {
		display: block;
		width: 100%;
		aspect-ratio: 1920 / 400;
		min-height: 160px;
		object-fit: cover;
		border-radius: 14px;
	}
	.pano figcaption {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.25em 1em;
		margin-top: 0.5em;
		font-size: 0.8em;
		color: rgb(var(--gray));
	}

	/* ---------- City strip ---------- */
	.city {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1em;
		margin-top: 3.5em;
	}
	.city-card {
		padding: 1.2em 1.3em;
		border-radius: 14px;
		background: var(--fog);
		border-left: 4px solid var(--accent);
	}
	.city-card .tag {
		display: block;
		margin-bottom: 0.3em;
		font-size: 0.72em;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgb(var(--gray));
	}
	.city-card p {
		margin: 0;
		font-size: 0.9em;
		line-height: 1.5;
	}

	@media (max-width: 720px) {
		.hero-shade {
			background: linear-gradient(to top, rgba(15, 26, 44, 0.92) 0%, rgba(15, 26, 44, 0.55) 55%, rgba(15, 26, 44, 0.15) 100%);
		}
		.section-head h2 {
			font-size: 1.45em;
		}
		main.home {
			padding-top: 2.5em;
		}
	}
</style>
