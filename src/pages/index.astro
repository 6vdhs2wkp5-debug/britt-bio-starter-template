---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhotoCredit from '../components/PhotoCredit.astro';
import { SITE_DESCRIPTION } from '../consts';
import { PHOTOS } from '../photos';
import {
	PROFILE,
	STATS,
	STRENGTHS,
	EXPERIENCE,
	AI_WORKFLOWS,
	TOOLS,
	BOOK_CALL,
	EDUCATION,
} from '../resume';

const band = PHOTOS.night;
const pageTitle = `${PROFILE.name} | Executive Assistant & Office Manager, San Francisco`;
const bookAttrs = BOOK_CALL.external ? { target: '_blank', rel: 'noopener' } : {};

// Structured data so search engines connect the name, role and LinkedIn profile.
const personJsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: PROFILE.name,
	jobTitle: 'Executive Assistant',
	image: new URL(PROFILE.headshot, Astro.site).toString(),
	url: Astro.site?.toString(),
	sameAs: [PROFILE.linkedin],
	address: { '@type': 'PostalAddress', addressLocality: 'San Francisco', addressRegion: 'CA' },
	alumniOf: EDUCATION.school,
	knowsAbout: [
		'Executive support',
		'Calendar management',
		'International travel',
		'Investor relations',
		'Event planning',
		'Office operations',
		'AI workflow automation',
	],
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={SITE_DESCRIPTION} image="/og-image-2026-11-14c.jpg" />
		<script type="application/ld+json" set:html={personJsonLd} />
	</head>
	<body>
		<Header />

		<!-- ============ Hero ============ -->
		<section class="hero wrap" aria-labelledby="hero-title">
			<img
				class="avatar"
				src={PROFILE.headshotSmall}
				srcset={`${PROFILE.headshotSmall} 320w, ${PROFILE.headshot} 640w`}
				sizes="(max-width: 640px) 120px, 176px"
				width="176"
				height="176"
				alt={`Portrait of ${PROFILE.name}`}
				fetchpriority="high"
			/>
			<div class="hero-text">
				<p class="eyebrow">Private equity &nbsp;·&nbsp; Executive support</p>
				<h1 id="hero-title">{PROFILE.name}</h1>
				<p class="role">Executive Assistant <span aria-hidden="true">&amp;</span><span class="sr-only">and</span> Office Manager</p>
				<p class="lede">
					A San Francisco executive assistant dedicated to helping partners and investment leaders
					reach their goals.
				</p>
				<div class="actions">
					<a class="btn btn-solid" href={BOOK_CALL.href} {...bookAttrs}>Book a call</a>
					<a class="btn btn-line" href={PROFILE.resume} target="_blank" rel="noopener">View resume</a>
				</div>
				<p class="status"><span class="dot" aria-hidden="true"></span>Open to new opportunities</p>
			</div>
		</section>

		<!-- ============ Firms ============ -->
		<section class="firms wrap" aria-label="Firms supported">
			<span class="firms-label">Experience includes</span>
			<ul>
				<li>CVC Advisors</li>
				<li>Centana Growth Partners</li>
				<li>Owl Ventures</li>
			</ul>
		</section>

		<main>
			<!-- ============ Stats ============ -->
			<section class="stats wrap" aria-label="At a glance">
				{
					STATS.map((s) => (
						<div class="stat">
							<span class="stat-value">{s.value}</span>
							<span class="stat-label">{s.label}</span>
						</div>
					))
				}
			</section>

			<!-- ============ Expertise ============ -->
			<section id="expertise" class="section wrap" aria-labelledby="strengths-title">
				<header class="section-head">
					<p class="kicker">Expertise</p>
					<h2 id="strengths-title">Handling the details, so partners don’t have to</h2>
				</header>
				<div class="strengths">
					{
						STRENGTHS.map((s, i) => (
							<article class="strength">
								<span class="num">{String(i + 1).padStart(2, '0')}</span>
								<h3>{s.title}</h3>
								<p>{s.body}</p>
							</article>
						))
					}
				</div>
			</section>

			<!-- ============ Experience ============ -->
			<section id="experience" class="section wrap" aria-labelledby="experience-title">
				<header class="section-head split">
					<div>
						<p class="kicker">Experience</p>
						<h2 id="experience-title">Career highlights</h2>
					</div>
					<a class="text-link" href={PROFILE.resume} target="_blank" rel="noopener">Full resume (PDF) <span aria-hidden="true">→</span></a>
				</header>
				<ol class="timeline">
					{
						EXPERIENCE.map((role) => (
							<li class="role-item">
								<div class="role-meta">
									<span class="dates">{role.dates}</span>
									{role.featured && <span class="featured">{role.featured}</span>}
								</div>
								<div class="role-body">
									<h3>{role.company}</h3>
									<p class="role-title">{role.title}</p>
									<ul>
										{role.highlights.map((h) => (
											<li>{h}</li>
										))}
									</ul>
								</div>
							</li>
						))
					}
				</ol>
			</section>

			<!-- ============ AI workflows ============ -->
			<section id="ai" class="ai" aria-labelledby="ai-title">
				<div class="wrap ai-grid">
					<div class="ai-intro">
						<p class="kicker">AI workflows</p>
						<h2 id="ai-title">Built around each partner</h2>
						<p>
							Every partner works differently, so one-size-fits-all tools fall short. Each workflow is
							designed, built and given clear guidelines around one executive, so routine work runs
							reliably and more time goes to people and judgment calls.
						</p>
						<p class="tools">
							<span class="tools-label">Everyday tools</span>
							{[...TOOLS.AI, ...TOOLS.Systems].join(' · ')}
						</p>
					</div>
					<ol class="flows">
						{
							AI_WORKFLOWS.map((w) => (
								<li class="flow">
									<span class="num">{w.step}</span>
									<div>
										<h3>{w.title}</h3>
										<ul>
											{w.points.map((d) => (
												<li>{d}</li>
											))}
										</ul>
									</div>
								</li>
							))
						}
					</ol>
				</div>
			</section>

			<!-- ============ Education ============ -->
			<section class="section wrap edu" aria-labelledby="edu-title">
				<div>
					<p class="kicker">Education</p>
					<h2 id="edu-title">{EDUCATION.school}</h2>
				</div>
				<div class="edu-detail">
					<p>{EDUCATION.degree} &nbsp;·&nbsp; {EDUCATION.dates}<br />{EDUCATION.note}</p>
					<a class="text-link" href="/about">More about Brittany <span aria-hidden="true">→</span></a>
				</div>
			</section>
		</main>

		<!-- ============ Contact ============ -->
		<section id="contact" class="contact" aria-labelledby="contact-title">
			<img
				class="contact-photo"
				src={band.src}
				srcset={`${band.srcSmall} 960w, ${band.src} 1280w`}
				sizes="100vw"
				width={band.width}
				height={band.height}
				alt=""
				loading="lazy"
			/>
			<div class="contact-shade" aria-hidden="true"></div>
			<div class="contact-text wrap">
				<p class="kicker">Contact</p>
				<h2 id="contact-title">Let’s talk</h2>
				<p class="people">
					“I care about the people I support beyond their calendars: their wellbeing, their families
					and their lives outside the office.”
				</p>
				<div class="actions">
					<a class="btn btn-light" href={BOOK_CALL.href} {...bookAttrs}>Book a call</a>
					<a class="btn btn-line-light" href={`mailto:${PROFILE.email}`}>Email</a>
					<a class="btn btn-line-light" href={PROFILE.linkedin} target="_blank" rel="noopener">LinkedIn</a>
				</div>
			</div>
			<PhotoCredit photo={band} class="contact-credit" />
		</section>

		<Footer />
	</body>
</html>

<style>
	/* ---------- Layout ---------- */
	.wrap {
		width: 1120px;
		max-width: calc(100% - 3rem);
		margin-left: auto;
		margin-right: auto;
	}
	main {
		width: auto;
		max-width: none;
		padding: 0;
	}
	.section {
		padding: 6.5rem 0 0;
	}
	.kicker,
	.eyebrow {
		margin: 0 0 1rem;
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--accent);
	}
	h2 {
		font-size: clamp(1.9rem, 3.4vw, 2.6rem);
		font-weight: 400;
		margin: 0;
	}
	.section-head {
		max-width: 820px;
		margin-bottom: 3.25rem;
	}
	.section-head.split {
		max-width: none;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem;
		padding-bottom: 2rem;
		margin-bottom: 0;
		border-bottom: 1px solid var(--rule);
	}
	.text-link {
		font-size: 0.85rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		color: var(--ink);
		text-decoration: none;
		border-bottom: 1px solid var(--gold);
		padding-bottom: 2px;
		white-space: nowrap;
	}
	.text-link:hover {
		color: var(--accent);
	}

	/* ---------- Buttons ---------- */
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 9.5rem;
		padding: 1rem 1.8rem;
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		text-decoration: none;
		border: 1px solid transparent;
		transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
	}
	.btn-solid {
		background: var(--ink);
		color: #fff;
	}
	.btn-solid:hover {
		background: var(--ink-dark);
		color: #fff;
	}
	.btn-line {
		border-color: var(--ink);
		color: var(--ink);
	}
	.btn-line:hover {
		background: var(--ink);
		color: #fff;
	}
	.btn-light {
		background: #fff;
		color: var(--ink);
	}
	.btn-light:hover {
		background: var(--champagne);
		color: var(--ink);
	}
	.btn-line-light {
		border-color: rgba(255, 255, 255, 0.55);
		color: #fff;
	}
	.btn-line-light:hover {
		border-color: #fff;
		background: rgba(255, 255, 255, 0.08);
		color: #fff;
	}

	/* ---------- Hero ---------- */
	.hero {
		display: grid;
		grid-template-columns: 176px minmax(0, 1fr);
		gap: 3.5rem;
		align-items: start;
		padding: 5rem 0 4.5rem;
	}
	.hero-text {
		max-width: 40rem;
	}
	.hero h1 {
		margin: 0;
		font-size: clamp(3rem, 6.4vw, 5.2rem);
		font-weight: 400;
		line-height: 1;
		letter-spacing: -0.01em;
		color: var(--ink);
	}
	.role {
		margin: 1rem 0 0;
		font-family: var(--serif);
		font-style: italic;
		font-size: clamp(1.3rem, 2.2vw, 1.65rem);
		color: var(--accent);
	}
	.lede {
		max-width: 31rem;
		margin: 1.75rem 0 2.5rem;
		padding-top: 1.75rem;
		border-top: 1px solid var(--rule);
		font-size: 1.06rem;
		line-height: 1.75;
		color: rgb(var(--gray));
	}
	.status {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 2rem 0 0;
		font-size: 0.82rem;
		letter-spacing: 0.02em;
		color: rgb(var(--gray));
	}
	.dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--gold);
		box-shadow: 0 0 0 4px rgba(168, 135, 90, 0.18);
	}
	.avatar {
		display: block;
		width: 176px;
		height: 176px;
		border-radius: 50%;
		object-fit: cover;
		background: #fff;
		border: 4px solid #fff;
		box-shadow:
			0 0 0 1px var(--gold),
			0 18px 40px -18px rgba(19, 35, 58, 0.35);
	}

	/* ---------- Firms ---------- */
	.firms {
		display: flex;
		align-items: center;
		gap: 2.5rem;
		padding: 1.6rem 0;
		border-top: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
	}
	.firms-label {
		flex: none;
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: rgb(var(--gray));
	}
	.firms ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.firms li {
		font-family: var(--serif);
		font-size: 1.35rem;
		color: var(--ink);
	}

	/* ---------- Stats ---------- */
	.stats {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		padding-top: 4.5rem;
	}
	.stat {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 0 2rem;
		border-left: 1px solid var(--rule);
	}
	.stat:first-child {
		padding-left: 0;
		border-left: 0;
	}
	.stat-value {
		font-family: var(--serif);
		font-size: 2.2rem;
		line-height: 1.1;
		color: var(--ink);
	}
	.stat-label {
		font-size: 0.88rem;
		line-height: 1.55;
		color: rgb(var(--gray));
	}

	/* ---------- Expertise ---------- */
	.strengths {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 3rem 3.5rem;
	}
	.strength {
		padding-top: 1.5rem;
		border-top: 1px solid var(--ink);
	}
	.num {
		display: block;
		margin-bottom: 0.9rem;
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		color: var(--accent);
	}
	.strength h3 {
		margin: 0 0 0.6rem;
		font-size: 1.5rem;
		font-weight: 500;
	}
	.strength p {
		margin: 0;
		font-size: 0.93rem;
		line-height: 1.7;
		color: rgb(var(--gray));
	}

	/* ---------- Experience ---------- */
	.timeline {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.role-item {
		display: grid;
		grid-template-columns: 220px 1fr;
		gap: 2.5rem;
		padding: 2.5rem 0;
		border-bottom: 1px solid var(--rule);
	}
	.role-meta {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding-top: 0.45rem;
	}
	.dates {
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgb(var(--gray));
	}
	.featured {
		font-size: 0.8rem;
		font-style: italic;
		font-family: var(--serif);
		color: var(--accent);
		font-size: 1rem;
	}
	.role-body h3 {
		margin: 0;
		font-size: 1.65rem;
		font-weight: 500;
	}
	.role-title {
		margin: 0.2rem 0 1rem;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--accent);
	}
	.role-body ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.role-body li {
		position: relative;
		margin: 0 0 0.55rem;
		padding-left: 1.35rem;
		font-size: 0.97rem;
		line-height: 1.7;
	}
	.role-body li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.8em;
		width: 0.6rem;
		height: 1px;
		background: var(--gold);
	}

	/* ---------- AI ---------- */
	.ai {
		margin-top: 6.5rem;
		padding: 6rem 0;
		background: var(--panel);
	}
	.ai-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: 5rem;
		align-items: start;
	}
	.ai-intro h2 {
		margin-bottom: 1.5rem;
	}
	.ai-intro p:not(.kicker) {
		font-size: 1rem;
		line-height: 1.8;
		color: rgb(var(--gray-dark));
	}
	.tools {
		margin: 2.25rem 0 0;
		padding-top: 1.5rem;
		border-top: 1px solid var(--rule);
		font-size: 0.88rem !important;
		line-height: 1.9 !important;
		color: rgb(var(--gray)) !important;
	}
	.tools-label {
		display: block;
		margin-bottom: 0.35rem;
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.flows {
		margin: 0;
		padding: 0;
		list-style: none;
		background: #fff;
		border: 1px solid var(--rule);
	}
	.flow {
		display: grid;
		grid-template-columns: 3rem 1fr;
		gap: 1rem;
		padding: 2rem 2.25rem;
		border-top: 1px solid var(--rule);
	}
	.flow:first-child {
		border-top: 0;
	}
	.flow .num {
		margin: 0.45rem 0 0;
	}
	.flow h3 {
		margin: 0 0 0.6rem;
		font-size: 1.45rem;
		font-weight: 500;
	}
	.flow ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.flow li {
		margin: 0 0 0.35rem;
		font-size: 0.93rem;
		line-height: 1.65;
		color: rgb(var(--gray));
	}

	/* ---------- Education ---------- */
	.edu {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 3rem;
		align-items: end;
		padding-bottom: 6.5rem;
	}
	.edu-detail p {
		margin: 0 0 1rem;
		font-size: 1rem;
		color: rgb(var(--gray));
	}

	/* ---------- Contact ---------- */
	.contact {
		position: relative;
		overflow: hidden;
		padding: 7rem 0;
		background: var(--ink);
		color: #fff;
		text-align: center;
	}
	.contact-photo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 60% 45%;
		border-radius: 0;
	}
	.contact-shade {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(11, 22, 38, 0.78), rgba(11, 22, 38, 0.88));
	}
	.contact-text {
		position: relative;
		max-width: 46rem;
	}
	.contact .kicker {
		color: var(--champagne);
	}
	.contact h2 {
		color: #fff;
		font-size: clamp(2.4rem, 4.6vw, 3.4rem);
	}
	.people {
		margin: 1.5rem auto 2.75rem;
		font-family: var(--serif);
		font-style: italic;
		font-size: clamp(1.2rem, 2.2vw, 1.5rem);
		line-height: 1.55;
		color: rgba(255, 255, 255, 0.88);
	}
	.contact .actions {
		justify-content: center;
	}
	.contact :global(.contact-credit) {
		position: absolute;
		right: 1rem;
		bottom: 0.6rem;
		color: rgba(255, 255, 255, 0.45);
	}

	/* ---------- Responsive ---------- */
	@media (max-width: 960px) {
		.strengths {
			grid-template-columns: repeat(2, 1fr);
		}
		.stats {
			grid-template-columns: repeat(2, 1fr);
			row-gap: 2.5rem;
		}
		.stat:nth-child(3) {
			padding-left: 0;
			border-left: 0;
		}
		.ai-grid {
			grid-template-columns: 1fr;
			gap: 3rem;
		}
	}
	@media (max-width: 860px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 2rem;
			padding-top: 3rem;
		}
		.firms {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.75rem;
		}
	}
	@media (max-width: 640px) {
		.wrap {
			max-width: calc(100% - 2.5rem);
		}
		.section {
			padding-top: 4.5rem;
		}
		.strengths {
			grid-template-columns: 1fr;
			gap: 2.25rem;
		}
		.stats {
			grid-template-columns: 1fr 1fr;
		}
		.stat {
			padding: 0 1rem;
		}
		.stat-value {
			font-size: 1.8rem;
		}
		.role-item {
			grid-template-columns: 1fr;
			gap: 0.75rem;
			padding: 2rem 0;
		}
		.section-head.split {
			flex-direction: column;
			align-items: flex-start;
		}
		.edu {
			grid-template-columns: 1fr;
			gap: 1rem;
			padding-bottom: 4.5rem;
		}
		.flow {
			grid-template-columns: 1fr;
			gap: 0.25rem;
			padding: 1.75rem 1.5rem;
		}
		.ai {
			margin-top: 4.5rem;
			padding: 4.5rem 0;
		}
		.contact {
			padding: 5rem 0 5.5rem;
		}
		.btn {
			flex: 1 1 auto;
