---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhotoCredit from '../components/PhotoCredit.astro';
import { SITE_DESCRIPTION } from '../consts';
import { PHOTOS } from '../photos';
import {
	PROFILE,
	STATS,
	STRENGTHS,
	EXPERIENCE,
	AI_WORKFLOWS,
	TOOLS,
	BOOK_CALL,
	EDUCATION,
} from '../resume';

const hero = PHOTOS.night;
const pano = PHOTOS.skyline;
const pageTitle = `${PROFILE.name} | Executive Assistant & Office Manager, San Francisco`;

// Structured data so search engines connect the name, role and LinkedIn profile.
const personJsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: PROFILE.name,
	jobTitle: 'Executive Assistant',
	image: new URL(PROFILE.headshot, Astro.site).toString(),
	url: Astro.site?.toString(),
	sameAs: [PROFILE.linkedin],
	address: { '@type': 'PostalAddress', addressLocality: 'San Francisco', addressRegion: 'CA' },
	alumniOf: EDUCATION.school,
	knowsAbout: [
		'Executive support',
		'Calendar management',
		'International travel',
		'Investor relations',
		'Event planning',
		'Office operations',
		'AI workflow automation',
	],
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={SITE_DESCRIPTION} image="/og-image-2026-11-14c.jpg" />
		<link rel="preload" as="image" href={hero.src} imagesrcset={`${hero.srcSmall} 960w, ${hero.src} 1280w`} imagesizes="100vw" />
		<script type="application/ld+json" set:html={personJsonLd} />
	</head>
	<body>
		<Header />

		<!-- ============ Hero ============ -->
		<section class="hero" aria-labelledby="hero-title">
			<img
				class="hero-photo"
				src={hero.src}
				srcset={`${hero.srcSmall} 960w, ${hero.src} 1280w`}
				sizes="100vw"
				width={hero.width}
				height={hero.height}
				alt={hero.alt}
				fetchpriority="high"
			/>
			<div class="hero-shade" aria-hidden="true"></div>
			<div class="hero-text">
				<img
					class="avatar"
					src={PROFILE.headshotSmall}
					srcset={`${PROFILE.headshotSmall} 320w, ${PROFILE.headshot} 640w`}
					sizes="128px"
					width="128"
					height="128"
					alt={`Portrait of ${PROFILE.name}`}
				/>
				<h1 id="hero-title">{PROFILE.name}</h1>
				<p class="hero-role">{PROFILE.title}</p>
				<p class="lede">A San Francisco executive assistant dedicated to helping <br class="br-wide" />partners and investment leaders reach their goals.</p>
				<p class="firms"><span>CVC Advisors</span><span class="firms-sep" aria-hidden="true">·</span><span>Centana Growth Partners</span></p>
				<span class="bar" aria-hidden="true"></span>
				<div class="actions">
					<a class="button primary" href={PROFILE.resume} target="_blank" rel="noopener">View Resume</a>
					<a class="button ghost" href={BOOK_CALL.href} target={BOOK_CALL.external ? '_blank' : undefined} rel={BOOK_CALL.external ? 'noopener' : undefined}>Book a call</a>
					<a class="button ghost" href={PROFILE.linkedin} target="_blank" rel="noopener">LinkedIn</a>
				</div>
				<p class="status"><span class="dot" aria-hidden="true"></span>San Francisco · Open to new opportunities</p>
			</div>
			<PhotoCredit photo={hero} class="hero-credit" />
		</section>

		<main class="home">
			<!-- ============ Stats ============ -->
			<section class="stats" aria-label="At a glance">
				{
					STATS.map((s) => (
						<div class="stat">
							<span class="stat-value">{s.value}</span>
							<span class="stat-label">{s.label}</span>
						</div>
					))
				}
			</section>

			<!-- ============ Strengths ============ -->
			<section id="strengths" class="block" aria-labelledby="strengths-title">
				<p class="kicker">Expertise</p>
				<h2 id="strengths-title">Handling the details, so partners don’t have to</h2>
				<div class="strengths">
					{
						STRENGTHS.map((s, i) => (
							<article class="strength">
								<span class="num">{String(i + 1).padStart(2, '0')}</span>
								<h3>{s.title}</h3>
								<p>{s.body}</p>
							</article>
						))
					}
				</div>
			</section>

			<!-- ============ Experience ============ -->
			<section id="experience" class="block" aria-labelledby="experience-title">
				<div class="section-head">
					<div>
						<p class="kicker">Experience</p>
						<h2 id="experience-title">Career highlights</h2>
					</div>
					<a class="see-all" href={PROFILE.resume} target="_blank" rel="noopener">Full resume (PDF) →</a>
				</div>
				<ol class="timeline">
					{
						EXPERIENCE.map((role) => (
							<li class:list={["role", { "is-featured": role.featured }]}>
								<div class="role-meta">
									<span class="dates">{role.dates}</span>
									{role.featured && <span class="featured">{role.featured}</span>}
								</div>
								<div class="role-body">
									<h3>
										{role.title} <span class="at">at</span> <span class="company">{role.company}</span>
									</h3>
									<ul>
										{role.highlights.map((h) => (
											<li>{h}</li>
										))}
									</ul>
									<p class="chips">
										{role.strengths.map((s) => (
											<span class="chip">{s}</span>
										))}
									</p>
								</div>
							</li>
						))
					}
				</ol>
			</section>
		</main>

		<!-- ============ AI workflows ============ -->
		<section id="ai" class="ai" aria-labelledby="ai-title">
			<div class="ai-inner">
				<div class="ai-intro">
					<p class="kicker">AI workflows</p>
					<h2 id="ai-title">Built around each partner</h2>
					<p>
						Every partner works differently, so one-size-fits-all tools fall short. Each workflow is
						designed, built and given clear guidelines around one executive, so routine work runs
						reliably and more time goes to people and judgment calls.
					</p>
					<div class="tools">
						<span class="tool-label">Everyday tools</span>
						<p class="chips">
							{
								[...TOOLS.AI, ...TOOLS.Systems].map((t) => (
									<span class:list={['chip', { 'is-ai': TOOLS.AI.includes(t) }]}>{t}</span>
								))
							}
						</p>
					</div>
				</div>
				<div class="flows">
					{
						AI_WORKFLOWS.map((w) => (
							<article class="flow">
								<header class="flow-head">
									<span class="step-num">{w.step}</span>
									<h3>{w.title}</h3>
								</header>
								<ul class="steps">
									{w.points.map((d) => (
										<li>{d}</li>
									))}
								</ul>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<main class="home">
			<!-- ============ Education + background ============ -->
			<section class="block edu" aria-labelledby="edu-title">
				<div class="edu-card">
					<p class="kicker">Education</p>
					<h2 id="edu-title">{EDUCATION.school}</h2>
					<p class="edu-line">{EDUCATION.degree} &nbsp;·&nbsp; {EDUCATION.dates}</p>
					<p class="edu-note">{EDUCATION.note}</p>
					<a class="text-link" href="/about">Read the full story <span aria-hidden="true">→</span></a>
				</div>
			</section>

			<!-- ============ Contact ============ -->
			<section id="contact" class="contact" aria-labelledby="contact-title">
				<img
					src={pano.src}
					srcset={`${pano.srcSmall} 960w, ${pano.src} 1920w`}
					sizes="(max-width: 1080px) 100vw, 1080px"
					width={pano.width}
					height={pano.height}
					alt=""
					loading="lazy"
				/>
				<div class="contact-shade" aria-hidden="true"></div>
				<div class="contact-text">
					<h2 id="contact-title">Let's talk</h2>
					<p class="people">I care about the people I support beyond their calendars: their wellbeing, their families and their lives outside the office.</p>
					<p>Hiring an executive assistant or office manager in San Francisco? Book a quick call or send a note.</p>
					<div class="actions">
						<a class="button primary" href={BOOK_CALL.href} target={BOOK_CALL.external ? '_blank' : undefined} rel={BOOK_CALL.external ? 'noopener' : undefined}>Book a call</a>
						<a class="button ghost" href={`mailto:${PROFILE.email}`}>Email me</a>
						<a class="button ghost" href={PROFILE.linkedin} target="_blank" rel="noopener">Connect on LinkedIn</a>
						<a class="button ghost" href={PROFILE.resume} target="_blank" rel="noopener">Resume (PDF)</a>
					</div>
				</div>
				<PhotoCredit photo={pano} class="contact-credit" />
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	/* ---------- Shared ---------- */
	main.home {
		width: 1080px;
		padding-top: 0;
		padding-bottom: 0;
	}
	.block {
		padding-top: 4.5em;
	}
	.kicker {
		margin: 0 0 0.6em;
		font-size: var(--caps-size);
		font-weight: 500;
		letter-spacing: var(--caps-track);
		text-transform: uppercase;
		color: var(--accent);
	}
	.kicker.light {
		color: var(--sunset);
	}
	h2 {
		font-size: clamp(1.6rem, 3.6vw, 2.3rem);
		margin-bottom: 0.9em;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4em;
		margin: 0;
	}
	.chip {
		white-space: nowrap;
		line-height: 1.6;
		padding: 0.15em 0.7em;
		border-radius: 2px;
		background: rgb(var(--gray-light));
		font-size: 0.7em;
		font-weight: 500;
		color: rgb(var(--gray-dark));
	}
	.chip.dark {
		background: rgba(255, 255, 255, 0.1);
		color: #fff;
		border: 1px solid rgba(255, 255, 255, 0.2);
	}
	.button {
		display: inline-block;
		padding: 0.95em 1.7em;
		border-radius: 2px;
		font-size: var(--caps-size);
		font-weight: 500;
		letter-spacing: var(--caps-track);
		text-transform: uppercase;
		text-decoration: none;
		transition:
			transform 0.15s ease,
			background 0.15s ease;
	}
	.button:hover {
		transform: translateY(-1px);
	}
	.button.primary {
		background: var(--ink);
		color: #fff;
	}
	.button.primary:hover {
		background: var(--ink-dark);
		color: #fff;
	}
	/* on dark photography, the main action is a clean white button */
	.hero .button.primary,
	.contact .button.primary {
		background: #fff;
		color: var(--ink);
	}
	.hero .button.primary:hover,
	.contact .button.primary:hover {
		background: var(--fog);
		color: var(--ink);
	}
	.button.ghost {
		background: rgba(255, 255, 255, 0.1);
		color: #fff;
		border: 1px solid rgba(255, 255, 255, 0.45);
		backdrop-filter: blur(6px);
	}
	.button.ghost:hover {
		background: rgba(255, 255, 255, 0.2);
		color: #fff;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6em;
	}

	/* ---------- Hero ---------- */
	.hero {
		position: relative;
		display: flex;
		align-items: center;
		min-height: clamp(560px, 86vh, 820px);
		overflow: hidden;
		background: #0b1424;
		color: #fff;
	}
	.hero-photo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 70% 50%;
		border-radius: 0;
		animation: settle 1.8s ease-out both;
	}
	@keyframes settle {
		from {
			transform: scale(1.06);
			opacity: 0.6;
		}
		to {
			transform: scale(1);
			opacity: 1;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-photo {
			animation: none;
		}
	}
	.hero-shade {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(to right, rgba(9, 16, 30, 0.9) 0%, rgba(9, 16, 30, 0.6) 40%, rgba(9, 16, 30, 0.05) 75%),
			linear-gradient(to top, rgba(9, 16, 30, 0.75) 0%, transparent 35%);
	}
	.hero-text {
		position: relative;
		z-index: 1;
		width: 1080px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 3em 0 5em;
	}
	.avatar {
		display: block;
		width: 128px;
		height: 128px;
		margin-bottom: 1.4em;
		border-radius: 50%;
		object-fit: cover;
		border: 4px solid #fff;
		box-shadow:
			0 0 0 4px #a8875a,
			0 12px 32px rgba(0, 0, 0, 0.45);
	}
	.hero h1 {
		margin: 0 0 0.25em;
		font-size: clamp(3.2rem, 8.5vw, 6rem);
		font-weight: 500;
		line-height: 0.98;
		letter-spacing: -0.005em;
		color: #fff;
		text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
	}
	.hero-role {
		margin: 0 0 0.45em;
		font-family: var(--serif);
		font-style: italic;
		font-weight: 400;
		font-size: clamp(1.4rem, 3vw, 2rem);
		line-height: 1.25;
		color: var(--champagne);
	}
	.lede {
		max-width: 34em;
		margin: 0 0 1.3em;
		font-size: clamp(1rem, 1.9vw, 1.2rem);
		color: rgba(255, 255, 255, 0.85);
	}
	@media (max-width: 720px) {
		.br-wide {
			display: none;
		}
	}
	.bar {
		display: block;
		width: 56px;
		height: 1px;
		margin-bottom: 2.2em;
		background: #a8875a;
	}
	.status {
		display: inline-flex;
		align-items: center;
		gap: 0.55em;
		margin: 1.3em 0 0;
		padding: 0.3em 0.9em;
		border-radius: 2px;
		background: rgba(255, 255, 255, 0.1);
		border: 1px solid rgba(255, 255, 255, 0.2);
		font-size: 0.78em;
		color: #fff;
	}
	.dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #c4a374;
		box-shadow: 0 0 0 4px rgba(196, 163, 116, 0.28);
	}
	.hero :global(.hero-credit) {
		position: absolute;
		right: 1em;
		top: 0.8em;
		z-index: 1;
		color: rgba(255, 255, 255, 0.75);
	}

	/* ---------- Stats ---------- */
	.stats {
		position: relative;
		z-index: 2;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		margin-top: -3.2em;
		background: #fff;
		border-radius: 4px;
		box-shadow: var(--box-shadow);
		overflow: hidden;
	}
	.stat {
		display: flex;
		flex-direction: column;
		gap: 0.25em;
		padding: 1.3em 1.4em;
		border-right: 1px solid rgb(var(--gray-light));
	}
	.stat:last-child {
		border-right: 0;
	}
	.stat-value {
		font-family: var(--serif);
		font-size: 2em;
		white-space: nowrap;
		font-weight: 500;
		line-height: 1;
		color: var(--ink);
	}
	.stat-label {
		font-size: 0.74em;
		line-height: 1.4;
		color: rgb(var(--gray));
	}

	/* ---------- Strengths ---------- */
	.strengths {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.2em;
	}
	.strength {
		padding: 1.4em 1.4em 1.5em;
		border-radius: 4px;
		background: #fff;
		border: 1px solid rgb(var(--gray-light));
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}
	.strength:hover {
		transform: translateY(-3px);
		box-shadow: var(--box-shadow);
	}
	.num {
		display: block;
		margin-bottom: 0.6em;
		font-size: 0.75em;
		font-weight: 500;
		color: var(--accent);
	}
	.strength h3 {
		margin: 0 0 0.4em;
		font-size: 1.35em;
	}
	.strength p {
		margin: 0;
		font-size: 0.82em;
		line-height: 1.55;
		color: rgb(var(--gray));
	}

	/* ---------- Experience ---------- */
	.section-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1em;
		flex-wrap: wrap;
		margin-bottom: 0.9em;
	}
	.section-head h2 {
		margin-bottom: 0;
	}
	.see-all {
		white-space: nowrap;
		font-size: var(--caps-size);
		font-weight: 500;
		letter-spacing: var(--caps-track);
		text-transform: uppercase;
		text-decoration: none;
		border-bottom: 1px solid var(--gold);
		padding-bottom: 2px;
	}
	.timeline {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.firms {
		margin: -0.2em 0 1.4em;
		font-size: var(--caps-size);
		font-weight: 500;
		letter-spacing: var(--caps-track);
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.72);
	}
	.firms span {
		display: inline-block;
	}
	.firms-sep {
		margin: 0 0.9em;
	}
	@media (max-width: 720px) {
		.firms {
			letter-spacing: var(--caps-track);
		}
		.firms span {
			display: block;
		}
		.firms-sep {
			display: none !important;
		}
		.hero .actions .button {
			flex: 1 1 40%;
			text-align: center;
		}
	}
	.featured {
		display: inline-block;
		margin-top: 0.5em;
		padding: 0.15em 0.6em;
		border-radius: 2px;
		background: rgba(168, 135, 90, 0.16);
		color: var(--accent-dark);
		font-size: 0.62rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.role.is-featured .role-meta {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}
	.contact .people {
		margin-bottom: 0.8em;
		font-family: var(--serif);
		font-style: italic;
		font-size: 1.3em;
		line-height: 1.5;
		color: #fff;
	}
	.role {
		display: grid;
		grid-template-columns: 11em 1fr;
		gap: 1.5em;
		padding: 1.6em 0;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.dates {
		display: inline-block;
		font-size: 0.78em;
		font-weight: 500;
		color: rgb(var(--gray));
	}
	.role h3 {
		margin: 0 0 0.5em;
		font-size: 1.2em;
	}
	.at {
		font-weight: 400;
		color: rgb(var(--gray));
	}
	.company {
		color: var(--ink);
	}
	.role ul {
		margin: 0 0 0.8em;
		padding-left: 1.1em;
	}
	.role li {
		margin-bottom: 0.35em;
		font-size: 0.86em;
		line-height: 1.55;
	}

	/* ---------- AI section ---------- */
	.ai {
		margin-top: 4.5em;
		background: var(--fog);
		border-top: 1px solid rgb(var(--gray-light));
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.ai-inner {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: 3em;
		width: 1080px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 4.5em 0;
	}
	.ai-intro h2 {
		margin-bottom: 0.5em;
	}
	.ai-intro > p:not(.kicker) {
		font-size: 0.95em;
		color: rgb(var(--gray-dark));
	}
	.tools {
		margin-top: 1.8em;
	}
	.tool-label {
		display: block;
		margin-bottom: 0.6em;
		font-size: var(--caps-size);
		font-weight: 500;
		letter-spacing: var(--caps-track);
		text-transform: uppercase;
		color: rgb(var(--gray));
	}
	.chip {
		background: #fff;
		border: 1px solid rgb(var(--gray-light));
	}
	.chip.is-ai {
		background: var(--ink);
		border-color: var(--ink);
		color: #fff;
	}
	.flows {
		display: grid;
		gap: 1.2em;
		align-content: start;
	}
	.flow {
		position: relative;
		padding: 1.4em 1.5em 1.3em;
		border-radius: 4px;
		background: #fff;
		border: 1px solid rgb(var(--gray-light));
		box-shadow: 0 1px 2px rgba(var(--black), 0.04);
	}
	.flow::before {
		content: '';
		position: absolute;
		left: 0;
		top: 1.4em;
		bottom: 1.4em;
		width: 4px;
		border-radius: 0 4px 4px 0;
		background: var(--gold);
	}
	.flow-head {
		display: flex;
		align-items: center;
		gap: 0.8em;
		margin-bottom: 0.7em;
	}
	.step-num {
		display: inline-grid;
		place-items: center;
		width: 2.1em;
		height: 2.1em;
		border-radius: 50%;
		background: rgba(168, 135, 90, 0.14);
		color: var(--accent-dark);
		font-size: 0.75em;
		font-weight: 500;
