---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhotoCredit from '../components/PhotoCredit.astro';
import { SITE_DESCRIPTION } from '../consts';
import { PHOTOS } from '../photos';
import {
	PROFILE,
	STATS,
	STRENGTHS,
	EXPERIENCE,
	AI_WORKFLOWS,
	TOOLS,
	EDUCATION,
} from '../resume';

const hero = PHOTOS.night;
const pano = PHOTOS.skyline;
const pageTitle = `${PROFILE.name} | Executive Assistant & Office Manager, San Francisco`;

// Structured data so search engines connect the name, role and LinkedIn profile.
const personJsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: PROFILE.name,
	jobTitle: 'Executive Assistant',
	image: new URL(PROFILE.headshot, Astro.site).toString(),
	url: Astro.site?.toString(),
	sameAs: [PROFILE.linkedin],
	address: { '@type': 'PostalAddress', addressLocality: 'San Francisco', addressRegion: 'CA' },
	alumniOf: EDUCATION.school,
	knowsAbout: [
		'Executive support',
		'Calendar management',
		'International travel',
		'Investor relations',
		'Event planning',
		'Office operations',
		'AI workflow automation',
	],
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={SITE_DESCRIPTION} image="/og-image.jpg" />
		<link rel="preload" as="image" href={hero.src} imagesrcset={`${hero.srcSmall} 960w, ${hero.src} 1280w`} imagesizes="100vw" />
		<script type="application/ld+json" set:html={personJsonLd} />
	</head>
	<body>
		<Header />

		<!-- ============ Hero ============ -->
		<section class="hero" aria-labelledby="hero-title">
			<img
				class="hero-photo"
				src={hero.src}
				srcset={`${hero.srcSmall} 960w, ${hero.src} 1280w`}
				sizes="100vw"
				width={hero.width}
				height={hero.height}
				alt={hero.alt}
				fetchpriority="high"
			/>
			<div class="hero-shade" aria-hidden="true"></div>
			<div class="hero-text">
				<img
					class="avatar"
					src={PROFILE.headshotSmall}
					srcset={`${PROFILE.headshotSmall} 320w, ${PROFILE.headshot} 640w`}
					sizes="140px"
					width="140"
					height="140"
					alt={`Portrait of ${PROFILE.name}`}
				/>
				<p class="eyebrow"><span>{PROFILE.title}</span><span class="sep" aria-hidden="true"> &nbsp;·&nbsp; </span><span class="loc">{PROFILE.location}</span></p>
				<h1 id="hero-title">{PROFILE.name}</h1>
				<p class="lede">
					I keep partners and investment teams at private equity and venture capital firms running
					smoothly: calendars, travel, investor events and the office, handled with discretion and
					a step ahead.
				</p>
				<p class="status"><span class="dot" aria-hidden="true"></span>Open to Executive Assistant &amp; Office Manager roles in the Bay Area</p>
				<div class="actions">
					<a class="button primary" href={PROFILE.resume} download>Download résumé</a>
					<a class="button ghost" href={PROFILE.linkedin} target="_blank" rel="noopener">LinkedIn</a>
					<a class="button ghost" href={`mailto:${PROFILE.email}`}>Email me</a>
				</div>
			</div>
			<PhotoCredit photo={hero} class="hero-credit" />
		</section>

		<main class="home">
			<!-- ============ Stats ============ -->
			<section class="stats" aria-label="At a glance">
				{
					STATS.map((s) => (
						<div class="stat">
							<span class="stat-value">{s.value}</span>
							<span class="stat-label">{s.label}</span>
						</div>
					))
				}
			</section>

			<!-- ============ Strengths ============ -->
			<section id="strengths" class="block" aria-labelledby="strengths-title">
				<p class="kicker">What I bring</p>
				<h2 id="strengths-title">The support a partner never has to think about</h2>
				<div class="strengths">
					{
						STRENGTHS.map((s, i) => (
							<article class="strength">
								<span class="num">{String(i + 1).padStart(2, '0')}</span>
								<h3>{s.title}</h3>
								<p>{s.body}</p>
							</article>
						))
					}
				</div>
			</section>

			<!-- ============ Experience ============ -->
			<section id="experience" class="block" aria-labelledby="experience-title">
				<div class="section-head">
					<div>
						<p class="kicker">Experience</p>
						<h2 id="experience-title">Private equity, venture capital and beyond</h2>
					</div>
					<a class="see-all" href={PROFILE.resume} download>Full résumé (PDF) ↓</a>
				</div>
				<ol class="timeline">
					{
						EXPERIENCE.map((role) => (
							<li class="role">
								<div class="role-meta">
									<span class="dates">{role.dates}</span>
								</div>
								<div class="role-body">
									<h3>
										{role.title} <span class="at">at</span> <span class="company">{role.company}</span>
									</h3>
									<ul>
										{role.highlights.map((h) => (
											<li>{h}</li>
										))}
									</ul>
									<p class="chips">
										{role.strengths.map((s) => (
											<span class="chip">{s}</span>
										))}
									</p>
								</div>
							</li>
						))
					}
				</ol>
			</section>
		</main>

		<!-- ============ AI workflows (full-width band) ============ -->
		<section id="ai" class="ai-band" aria-labelledby="ai-title">
			<div class="ai-inner">
				<div class="ai-intro">
					<p class="kicker light">How I work</p>
					<h2 id="ai-title">AI-assisted, human-judged</h2>
					<p>
						I build repeatable workflows with AI so routine checks run on schedule and my time goes
						to the judgment calls. Two I designed and ran at Centana Growth Partners:
					</p>
				</div>
				<div class="ai-cards">
					{
						AI_WORKFLOWS.map((w) => (
							<article class="ai-card">
								<h3>{w.title}</h3>
								<p>{w.body}</p>
							</article>
						))
					}
				</div>
				<div class="tools">
					{
						Object.entries(TOOLS).map(([group, items]) => (
							<div class="tool-group">
								<span class="tool-label">{group}</span>
								<p class="chips">
									{items.map((t) => (
										<span class="chip dark">{t}</span>
									))}
								</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<main class="home">
			<!-- ============ Education + background ============ -->
			<section class="block edu" aria-labelledby="edu-title">
				<div class="edu-card">
					<p class="kicker">Education</p>
					<h2 id="edu-title">{EDUCATION.school}</h2>
					<p class="edu-line">{EDUCATION.degree} &nbsp;·&nbsp; {EDUCATION.dates}</p>
					<p class="edu-note">{EDUCATION.note}</p>
				</div>
				<div class="edu-card">
					<p class="kicker">Before the desk</p>
					<h2>Lead Flight Attendant, Virgin America</h2>
					<p class="edu-line">
						Conflict resolution and safety leadership at 35,000 feet: calm under pressure is a habit,
						not a talking point.
					</p>
					<a class="text-link" href="/about">More about me →</a>
				</div>
			</section>

			<!-- ============ Contact ============ -->
			<section id="contact" class="contact" aria-labelledby="contact-title">
				<img
					src={pano.src}
					srcset={`${pano.srcSmall} 960w, ${pano.src} 1920w`}
					sizes="(max-width: 1080px) 100vw, 1080px"
					width={pano.width}
					height={pano.height}
					alt=""
					loading="lazy"
				/>
				<div class="contact-shade" aria-hidden="true"></div>
				<div class="contact-text">
					<h2 id="contact-title">Let's talk</h2>
					<p>Hiring an Executive Assistant or Office Manager in San Francisco? I'd love to hear about the role.</p>
					<div class="actions">
						<a class="button primary" href={`mailto:${PROFILE.email}`}>Email me</a>
						<a class="button ghost" href={PROFILE.linkedin} target="_blank" rel="noopener">Connect on LinkedIn</a>
						<a class="button ghost" href={PROFILE.resume} download>Résumé (PDF)</a>
					</div>
				</div>
				<PhotoCredit photo={pano} class="contact-credit" />
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	/* ---------- Shared ---------- */
	main.home {
		width: 1080px;
		padding-top: 0;
		padding-bottom: 0;
	}
	.block {
		padding-top: 4.5em;
	}
	.kicker {
		margin: 0 0 0.4em;
		font-size: 0.72em;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.kicker.light {
		color: var(--sunset);
	}
	h2 {
		font-size: clamp(1.6rem, 3.6vw, 2.3rem);
		margin-bottom: 0.9em;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
		margin: 0;
	}
	.chip {
		padding: 0.15em 0.7em;
		border-radius: 999px;
		background: rgb(var(--gray-light));
		font-size: 0.7em;
		font-weight: 700;
		color: rgb(var(--gray-dark));
	}
	.chip.dark {
		background: rgba(255, 255, 255, 0.1);
		color: #fff;
		border: 1px solid rgba(255, 255, 255, 0.2);
	}
	.button {
		display: inline-block;
		padding: 0.6em 1.25em;
		border-radius: 999px;
		font-size: 0.85em;
		font-weight: 700;
		text-decoration: none;
		transition:
			transform 0.15s ease,
			background 0.15s ease;
	}
	.button:hover {
		transform: translateY(-1px);
	}
	.button.primary {
		background: var(--accent);
		color: #fff;
	}
	.button.primary:hover {
		background: var(--accent-dark);
		color: #fff;
	}
	.button.ghost {
		background: rgba(255, 255, 255, 0.1);
		color: #fff;
		border: 1px solid rgba(255, 255, 255, 0.55);
		backdrop-filter: blur(6px);
	}
	.button.ghost:hover {
		background: rgba(255, 255, 255, 0.2);
		color: #fff;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6em;
	}

	/* ---------- Hero ---------- */
	.hero {
		position: relative;
		display: flex;
		align-items: center;
		min-height: clamp(560px, 86vh, 820px);
		overflow: hidden;
		background: #0b1424;
		color: #fff;
	}
	.hero-photo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 70% 50%;
		border-radius: 0;
		animation: settle 1.8s ease-out both;
	}
	@keyframes settle {
		from {
			transform: scale(1.06);
			opacity: 0.6;
		}
		to {
			transform: scale(1);
			opacity: 1;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-photo {
			animation: none;
		}
	}
	.hero-shade {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(to right, rgba(9, 16, 30, 0.9) 0%, rgba(9, 16, 30, 0.6) 40%, rgba(9, 16, 30, 0.05) 75%),
			linear-gradient(to top, rgba(9, 16, 30, 0.75) 0%, transparent 35%);
	}
	.hero-text {
		position: relative;
		z-index: 1;
		width: 1080px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 3em 0 5em;
	}
	.avatar {
		display: block;
		width: 140px;
		height: 140px;
		margin-bottom: 1.2em;
		border-radius: 50%;
		object-fit: cover;
		border: 3px solid rgba(255, 255, 255, 0.9);
		box-shadow:
			0 0 0 6px rgba(192, 54, 44, 0.55),
			0 12px 32px rgba(0, 0, 0, 0.45);
	}
	.eyebrow {
		margin: 0 0 0.8em;
		font-size: 0.74em;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--sunset);
	}
	.hero h1 {
		margin: 0 0 0.3em;
		font-size: clamp(2.8rem, 7.5vw, 5.2rem);
		line-height: 1;
		color: #fff;
		text-shadow: 0 2px 24px rgba(0, 0, 0, 0.4);
	}
	.lede {
		max-width: 31em;
		margin: 0 0 1.1em;
		font-size: clamp(1.02rem, 2.1vw, 1.25rem);
		color: rgba(255, 255, 255, 0.92);
	}
	.status {
		display: inline-flex;
		align-items: center;
		gap: 0.55em;
		margin: 0 0 1.6em;
		padding: 0.3em 0.9em;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.1);
		border: 1px solid rgba(255, 255, 255, 0.2);
		font-size: 0.78em;
		color: #fff;
	}
	.dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #4ade80;
		box-shadow: 0 0 0 4px rgba(74, 222, 128, 0.25);
	}
	.hero :global(.hero-credit) {
		position: absolute;
		right: 1em;
		bottom: 4em;
		z-index: 1;
		color: rgba(255, 255, 255, 0.75);
	}

	/* ---------- Stats ---------- */
	.stats {
		position: relative;
		z-index: 2;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		margin-top: -3.2em;
		background: #fff;
		border-radius: 16px;
		box-shadow: var(--box-shadow);
		overflow: hidden;
	}
	.stat {
		display: flex;
		flex-direction: column;
		gap: 0.25em;
		padding: 1.3em 1.4em;
		border-right: 1px solid rgb(var(--gray-light));
	}
	.stat:last-child {
		border-right: 0;
	}
	.stat-value {
		font-family: var(--serif);
		font-size: 1.9em;
		font-weight: 700;
		line-height: 1;
		color: var(--accent);
	}
	.stat-label {
		font-size: 0.74em;
		line-height: 1.4;
		color: rgb(var(--gray));
	}

	/* ---------- Strengths ---------- */
	.strengths {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.2em;
	}
	.strength {
		padding: 1.4em 1.4em 1.5em;
		border-radius: 14px;
		background: #fff;
		border: 1px solid rgb(var(--gray-light));
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}
	.strength:hover {
		transform: translateY(-3px);
		box-shadow: var(--box-shadow);
	}
	.num {
		display: block;
		margin-bottom: 0.6em;
		font-size: 0.75em;
		font-weight: 700;
		color: var(--accent);
	}
	.strength h3 {
		margin: 0 0 0.4em;
		font-size: 1.12em;
	}
	.strength p {
		margin: 0;
		font-size: 0.82em;
		line-height: 1.55;
		color: rgb(var(--gray));
	}

	/* ---------- Experience ---------- */
	.section-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1em;
		flex-wrap: wrap;
		margin-bottom: 0.9em;
	}
	.section-head h2 {
		margin-bottom: 0;
	}
	.see-all {
		white-space: nowrap;
		font-size: 0.82em;
		font-weight: 700;
		text-decoration: none;
	}
	.timeline {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.role {
		display: grid;
		grid-template-columns: 11em 1fr;
		gap: 1.5em;
		padding: 1.6em 0;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.dates {
		display: inline-block;
		font-size: 0.78em;
		font-weight: 700;
		color: rgb(var(--gray));
	}
	.role h3 {
		margin: 0 0 0.5em;
		font-size: 1.2em;
	}
	.at {
		font-weight: 400;
		color: rgb(var(--gray));
	}
	.company {
		color: var(--accent);
	}
	.role ul {
		margin: 0 0 0.8em;
		padding-left: 1.1em;
	}
	.role li {
		margin-bottom: 0.35em;
		font-size: 0.86em;
		line-height: 1.55;
	}

	/* ---------- AI band ---------- */
	.ai-band {
		margin-top: 3.5em;
		background:
			radial-gradient(ellipse at 85% 0%, rgba(192, 54, 44, 0.25), transparent 55%),
			linear-gradient(160deg, #142640, #1f3a5f);
		color: rgba(255, 255, 255, 0.88);
	}
	.ai-inner {
		width: 1080px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 4.5em 0;
	}
	.ai-intro {
		max-width: 40em;
	}
	.ai-band h2 {
		color: #fff;
		margin-bottom: 0.5em;
	}
	.ai-intro p:last-child {
		font-size: 0.95em;
	}
	.ai-cards {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.2em;
		margin: 1.8em 0 2.2em;
	}
	.ai-card {
		padding: 1.4em;
		border-radius: 14px;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.14);
	}
	.ai-card h3 {
		margin: 0 0 0.4em;
		font-size: 1.12em;
		color: #fff;
	}
	.ai-card p {
		margin: 0;
		font-size: 0.84em;
		line-height: 1.6;
	}
	.tools {
		display: grid;
		gap: 0.8em;
	}
	.tool-group {
		display: grid;
		grid-template-columns: 6em 1fr;
		align-items: baseline;
		gap: 1em;
	}
	.tool-label {
		font-size: 0.72em;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--sunset);
	}

	/* ---------- Education ---------- */
	.edu {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.2em;
	}
	.edu-card {
		padding: 1.6em;
		border-radius: 14px;
		background: var(--fog);
		border-left: 4px solid var(--accent);
	}
	.edu-card h2 {
		font-size: 1.35em;
		margin-bottom: 0.35em;
	}
	.edu-line {
		margin: 0 0 0.4em;
		font-size: 0.88em;
	}
	.edu-note {
		margin: 0;
		font-size: 0.85em;
		font-weight: 700;
		color: var(--accent-dark);
	}
	.text-link {
		font-size: 0.85em;
		font-weight: 700;
		text-decoration: none;
	}

	/* ---------- Contact ---------- */
	.contact {
		position: relative;
		margin-top: 4.5em;
		border-radius: 18px;
		overflow: hidden;
		color: #fff;
	}
	.contact img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
	}
	.contact-shade {
		position: absolute;
		inset: 0;
		background: linear-gradient(100deg, rgba(20, 38, 64, 0.95) 0%, rgba(20, 38, 64, 0.75) 55%, rgba(20, 38, 64, 0.35) 100%);
	}
	.contact-text {
		position: relative;
		padding: 3em 2.4em 3.4em;
		max-width: 36em;
	}
	.contact h2 {
		color: #fff;
		margin-bottom: 0.3em;
	}
	.contact p {
		margin: 0 0 1.4em;
		color: rgba(255, 255, 255, 0.9);
	}
	.contact :global(.contact-credit) {
		position: absolute;
		right: 1em;
		bottom: 0.6em;
		color: rgba(255, 255, 255, 0.7);
	}

	/* ---------- Responsive ---------- */
	@media (max-width: 900px) {
		.stats {
			grid-template-columns: repeat(2, 1fr);
		}
		.stat:nth-child(2) {
			border-right: 0;
		}
		.stat:nth-child(-n + 2) {
			border-bottom: 1px solid rgb(var(--gray-light));
		}
		.strengths {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 720px) {
		.hero {
			align-items: flex-end;
		}
		.eyebrow .sep {
			display: none;
		}
		.avatar {
			width: 104px;
			height: 104px;
		}
		.eyebrow .loc {
			display: block;
			margin-top: 0.3em;
		}
		.hero-shade {
			background: linear-gradient(to top, rgba(9, 16, 30, 0.95) 0%, rgba(9, 16, 30, 0.7) 55%, rgba(9, 16, 30, 0.25) 100%);
		}
		.hero-photo {
			object-position: 75% 40%;
		}
		.stat {
			padding: 1em;
		}
		.stat-value {
			font-size: 1.5em;
		}
		.strengths,
		.ai-cards,
		.edu {
			grid-template-columns: 1fr;
		}
		.role {
			grid-template-columns: 1fr;
			gap: 0.3em;
		}
		.tool-group {
			grid-template-columns: 1fr;
			gap: 0.3em;
		}
		.contact-text {
			padding: 2.2em 1.4em 3em;
		}
