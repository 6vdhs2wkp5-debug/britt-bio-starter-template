---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhotoCredit from '../components/PhotoCredit.astro';
import { PHOTOS } from '../photos';
import { PROFILE, EDUCATION } from '../resume';

const banner = PHOTOS.aerial;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About ${PROFILE.name} | Executive Assistant, San Francisco`}
			description="How Brittany Helm went from leading cabin crews at Virgin America to supporting partners at San Francisco private equity and venture capital firms."
		/>
	</head>
	<body>
		<Header />

		<section class="banner">
			<img
				src={banner.src}
				srcset={`${banner.srcSmall} 960w, ${banner.src} 1920w`}
				sizes="100vw"
				width={banner.width}
				height={banner.height}
				alt={banner.alt}
			/>
			<div class="banner-shade" aria-hidden="true"></div>
			<div class="banner-text">
				<p class="eyebrow">About</p>
				<h1>Calm, prepared, a step ahead</h1>
			</div>
			<PhotoCredit photo={banner} class="banner-credit" />
		</section>

		<main>
			<article class="prose">
				<div class="intro-wrap">
					<img
						class="portrait"
						src={PROFILE.portrait}
						width="720"
						height="900"
						alt={`Portrait of ${PROFILE.name}`}
					/>
					<p class="intro">{PROFILE.summary}</p>
				</div>

				<h2>From the cabin to the corner office</h2>
				<p>
					My career started at 35,000 feet. As a Lead Flight Attendant at Virgin America, a program
					with under 1% acceptance, I served as Conflict Resolution Manager and Safety &amp;
					Compliance Coordinator. It taught me to stay calm when plans change at the last minute and
					to look after people before they have to ask.
				</p>
				<p>
					Since 2018 I've brought that into executive support: first for the CEO of ClinCapture,
					then for the team at Owl Ventures through a $1B+ fundraise, then for six senior investment
					leaders at CVC Advisors, where I also ran the 10-person West Coast office across the
					Financial District and the Presidio. Most recently at Centana Growth Partners, I supported a
					founding partner, a partner and their deal teams, and planned the firm's investor meeting,
					advisory boards and offsites.
				</p>

				<h2>How I work</h2>
				<ul>
					<li>
						<strong>Anticipate, don't react.</strong> Conflicts, visas and last-minute itinerary
						changes get solved before they reach the partner.
					</li>
					<li>
						<strong>Discretion by default.</strong> I'm trusted with sensitive matters and with
						executives' personal and family logistics.
					</li>
					<li>
						<strong>Automate the routine.</strong> I build AI-assisted workflows with Claude, ChatGPT
						and Copilot so calendar audits and expense reconciliation run on schedule.
					</li>
					<li>
						<strong>Relationships matter.</strong> Portfolio CEOs, LPs and advisory board members
						know they can come to me directly.
					</li>
				</ul>

				<h2>Off the clock</h2>
				<p>
					I studied Humanities at {EDUCATION.school}, where I was a {EDUCATION.note}. Leading a
					D1 squad turned out to be good training for keeping a team coordinated, on time and in
					sync.
				</p>

				<div class="cta">
					<a class="button primary" href={`mailto:${PROFILE.email}`}>Email me</a>
					<a class="button ghost" href={PROFILE.linkedin} target="_blank" rel="noopener">LinkedIn</a>
					<a class="button ghost" href={PROFILE.resume} download>Résumé (PDF)</a>
				</div>
			</article>
		</main>

		<Footer />
	</body>
</html>

<style>
	.banner {
		position: relative;
		min-height: clamp(260px, 42vh, 420px);
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		background: var(--bay);
		color: #fff;
	}
	.banner img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 55% 35%;
		border-radius: 0;
	}
	.banner-shade {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(15, 26, 44, 0.9), rgba(15, 26, 44, 0.25));
	}
	.banner-text {
		position: relative;
		width: 720px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding-bottom: 2.4em;
	}
	.eyebrow {
		margin: 0 0 0.4em;
		font-size: 0.74em;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--sunset);
	}
	.banner h1 {
		margin: 0;
		color: #fff;
		font-size: clamp(2rem, 5vw, 3.2rem);
	}
	.banner :global(.banner-credit) {
		position: absolute;
		right: 1em;
		bottom: 0.6em;
		color: rgba(255, 255, 255, 0.75);
	}
	.prose {
		padding-top: 1em;
	}
	.intro-wrap {
		display: grid;
		grid-template-columns: 220px 1fr;
		gap: 1.8em;
		align-items: start;
	}
	.portrait {
		position: relative;
		margin-top: -5.5em;
		width: 100%;
		height: auto;
		border-radius: 16px;
		border: 4px solid #fff;
		box-shadow: var(--box-shadow);
	}
	@media (max-width: 600px) {
		.intro-wrap {
			grid-template-columns: 1fr;
			justify-items: center;
		}
		.portrait {
			width: 200px;
			margin-top: -4em;
		}
	}
	.intro {
		margin: 0;
		padding-top: 0.6em;
		font-family: var(--serif);
		font-size: 1.2em;
		line-height: 1.6;
		color: rgb(var(--black));
	}
	.prose h2 {
		margin-top: 1.6em;
		font-size: 1.5em;
	}
	.prose li {
		margin-bottom: 0.6em;
	}
	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6em;
		margin-top: 2.5em;
	}
	.button {
		display: inline-block;
		padding: 0.6em 1.25em;
		border-radius: 999px;
		font-size: 0.85em;
		font-weight: 700;
		text-decoration: none;
	}
	.button.primary {
		background: var(--accent);
		color: #fff;
	}
	.button.primary:hover {
		background: var(--accent-dark);
		color: #fff;
	}
	.button.ghost {
		border: 1px solid rgba(var(--black), 0.2);
		color: rgb(var(--black));
	}
	.button.ghost:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
</style>
